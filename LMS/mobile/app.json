{
  "expo": {
    "name": "Gracified LMS",
    "slug": "gracified-lms-mobile",
    "scheme": "gracifiedlms",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.isaac_joseph.gracifiedlmsmobile",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon_adaptive.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.isaac_joseph.gracifiedlmsmobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "0023c05d-2ea5-4700-9fc2-1907c85914b9"
      }
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo_lightmode.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#fbfcff",
          "dark": {
            "image": "./assets/logo_darkmode.png",
            "backgroundColor": "#0a0d1f"
          }
        }
      ],
      "expo-status-bar"
    ]
  }
}
