{
  "expo": {
    "name": "Gracified LMS",
    "slug": "gracified-lms-mobile",
    "scheme": "gracifiedlms",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./gracified-expo-splash/assets/gracified/native-splash-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbfcff",
      "dark": {
        "image": "./gracified-expo-splash/assets/gracified/native-splash-dark.png",
        "backgroundColor": "#0a0d1f"
      }
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.isaac_joseph.gracifiedlmsmobile"
    },
    "extra": {
      "eas": {
        "projectId": "0023c05d-2ea5-4700-9fc2-1907c85914b9"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
